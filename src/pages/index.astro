---
import Base from '@/layouts/Base.astro';
import Navbar from '@/components/Navbar.astro';
import Hero from '@/components/Hero.astro';
import Experience from '@/components/sections/Experience.astro';
import Projects from '@/components/sections/Projects.astro';
import Social from '@/components/sections/Social.astro';
import Footer from '@/components/Footer.astro';
import ThemeTransitionStage from '@/components/ui/ThemeTransitionStage.astro';
---

<Base>
  <div id="page-shell" class="min-h-svh bg-canvas text-ink">
    <div class="max-w-[896px] sm:max-w-[960px] mx-auto px-5 sm:px-8 pl-[max(1.25rem,env(safe-area-inset-left))] pr-[max(1.25rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] flex flex-col min-h-svh justify-between">
      <div>
        <Navbar />
        <main class="flex flex-col gap-8 sm:gap-10">
          <Hero />
          <Experience />
          <Projects />
          <div class="pt-4 sm:pt-20">
            <Social />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </div>
  <ThemeTransitionStage />
</Base>
