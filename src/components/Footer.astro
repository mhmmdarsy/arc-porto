---
// Footer matching Figma Desktop - 1 with Live WITA Clock
import { siteMeta } from '@/data/portfolio';
import { formatWitaTime } from '@/utils/time';

const initialWitaTime = formatWitaTime();
---

<footer class="pt-8 sm:pt-10 pb-[max(2.5rem,calc(1.5rem+env(safe-area-inset-bottom)))] sm:pb-16 w-full" aria-label="Site Footer">
  <div
    class="flex items-center justify-between gap-4 text-[14px] sm:text-[16px] text-ink-muted font-normal"
  >
    <!-- Brand / Name -->
    <div>
      <span>{siteMeta.footerBrand}</span>
    </div>

    <!-- Location & Live WITA Clock (Samarinda, UTC+8) -->
    <div class="flex items-center gap-4 sm:gap-6 whitespace-nowrap">
      <span class="whitespace-nowrap">{siteMeta.location}</span>
      <div class="flex items-center gap-1.5 sm:gap-2 whitespace-nowrap">
        <time
          id="wita-clock"
          datetime=""
          class="font-sans tabular-nums select-none whitespace-nowrap"
          title={siteMeta.timezoneTitle}
        >
          {initialWitaTime}
        </time>
        <span class="whitespace-nowrap">{siteMeta.utcLabel}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initWitaClock } from '@/scripts/wita-clock';

  initWitaClock();
</script>
