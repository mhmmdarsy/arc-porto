---
// Footer matching Figma Desktop - 1 with Live WITA Clock
const initialWitaTime = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Asia/Makassar',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hour12: false,
})
  .format(new Date())
  .replace(/:/g, ' : ');
---

<footer class="pt-8 sm:pt-10 pb-[max(2.5rem,calc(1.5rem+env(safe-area-inset-bottom)))] sm:pb-16 w-full" aria-label="Site Footer">
  <div
    class="flex items-center justify-between gap-4 text-[14px] sm:text-[16px] text-ink-muted font-normal"
  >
    <!-- Brand / Name -->
    <div>
      <span>arc</span>
    </div>

    <!-- Location & Live WITA Clock (Samarinda, UTC+8) -->
    <div class="flex items-center gap-4 sm:gap-6 whitespace-nowrap">
      <span class="whitespace-nowrap">Samarinda, Indonesia</span>
      <time
        id="wita-clock"
        datetime=""
        class="font-sans tabular-nums select-none whitespace-nowrap"
        title="Waktu Indonesia Tengah (WITA / UTC+8)"
      >
        {initialWitaTime}
      </time>
    </div>
  </div>
</footer>

<script>
  function updateWitaClock() {
    const clockEl = document.getElementById('wita-clock');
    if (!clockEl) return;

    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Makassar',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });

      // Format with spaces matching Figma design: "HH : mm : ss"
      const formatted = formatter.format(now).replace(/:/g, ' : ');
      clockEl.textContent = formatted;
      clockEl.setAttribute('datetime', now.toISOString());
    } catch {
      // Fallback if timeZone not supported
      const now = new Date();
      const utc = now.getTime() + now.getTimezoneOffset() * 60000;
      const witaDate = new Date(utc + 3600000 * 8); // UTC+8
      const pad = (n: number) => n.toString().padStart(2, '0');
      const formatted = `${pad(witaDate.getHours())} : ${pad(witaDate.getMinutes())} : ${pad(witaDate.getSeconds())}`;
      clockEl.textContent = formatted;
    }
  }

  // Update immediately and on 1-second interval
  updateWitaClock();
  setInterval(updateWitaClock, 1000);
</script>
