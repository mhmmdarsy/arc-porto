---
const year = new Date().getFullYear();

const navLinks = [
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Experience', href: '#experience' },
  { label: 'Contact', href: '#contact' },
];

const socials = [
  { label: 'GitHub', href: 'https://github.com/mhmmdarsy' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mhmdarsy/' },
];
---

<footer class="border-t border-line bg-canvas text-ink">
  <div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-20">
    <div class="mb-16 grid grid-cols-1 gap-12 md:mb-20 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <h2 class="mb-4 text-4xl font-black uppercase tracking-tight md:text-5xl">
          craft.
        </h2>
        <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.22em] text-ink/55">
          Creative Studio
        </p>
        <p class="max-w-xs leading-relaxed text-ink/70">
          Crafting digital experiences with clean code and thoughtful design.
        </p>
      </div>

      <div class="md:col-span-3">
        <h3 class="mb-5 font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40">
          Navigate
        </h3>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="transition-opacity hover:opacity-60">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="mb-5 font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40">
          Connect
        </h3>
        <ul class="space-y-3">
          {
            socials.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-opacity hover:opacity-60"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-start justify-between gap-5 border-t border-line pt-10 md:flex-row md:items-center">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40">
        © {year} craft. studio
      </p>
      <div class="flex gap-8">
        <a
          href="#privacy"
          class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40 transition-opacity hover:opacity-100"
        >
          Privacy
        </a>
        <a
          href="#terms"
          class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40 transition-opacity hover:opacity-100"
        >
          Terms
        </a>
      </div>
    </div>
  </div>
</footer>
