---
const links = [
  { label: 'WORK', href: '#projects' },
  { label: 'SERVICES', href: '#skills' },
  { label: 'STUDIO', href: '#about' },
  { label: 'INFO', href: '#contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 transition-opacity duration-500"
  id="site-header"
>
  <nav
    class="mx-auto flex max-w-[1600px] items-center justify-between px-6 py-5 md:px-10"
    aria-label="Primary"
  >
    <a
      href="/"
      class="text-xl font-black tracking-tight text-ink transition-opacity hover:opacity-60"
    >
      craft.
    </a>

    <ul
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-10 font-mono text-[11px] tracking-[0.2em] text-ink/70 md:flex"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href="#contact" class="pill-solid text-[13px]">
      Start a project <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('opacity-0', y > lastY && y > 120);
      header.classList.toggle('pointer-events-none', y > lastY && y > 120);
      lastY = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
