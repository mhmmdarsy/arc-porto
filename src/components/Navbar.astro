---
// Navbar matching Figma Desktop - 1
---

<header class="w-full pt-6 pb-12">
  <nav class="flex items-center justify-between" aria-label="Main Navigation">
    <!-- Left: Menu Button & Cmd + K Shortcut -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="menu-toggle-btn"
        class="inline-flex items-center justify-center px-3.5 py-0.5 rounded border border-[#848484] text-[#FFFFFF] text-base hover:bg-white/5 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#848484]"
      >
        Menu
      </button>

      <!-- Keyboard Shortcut Indicator -->
      <div class="flex items-center gap-2 text-[#BFBFBF]" aria-label="Shortcut: Command K">
        <span
          class="inline-flex items-center justify-center w-[25px] h-[25px] rounded-[2px] border border-[#848484] text-xs select-none"
          title="Command"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Mac Command Symbol ⌘ -->
            <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
          </svg>
        </span>
        <span
          class="inline-flex items-center justify-center w-[25px] h-[25px] rounded-[2px] border border-[#848484] text-sm font-normal select-none"
        >
          K
        </span>
      </div>
    </div>

    <!-- Right: Dark Mode Indicator / Button -->
    <div>
      <button
        type="button"
        id="theme-btn"
        class="inline-flex items-center justify-center px-3.5 py-0.5 rounded border border-[#848484] text-[#FFFFFF] text-base hover:bg-white/5 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#848484]"
      >
        Dark
      </button>
    </div>
  </nav>
</header>

<script>
  // Keyboard shortcut listener for Cmd+K / Ctrl+K
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      const menuBtn = document.getElementById('menu-toggle-btn');
      menuBtn?.click();
    }
  });

  const menuBtn = document.getElementById('menu-toggle-btn');
  menuBtn?.addEventListener('click', () => {
    // Scroll to experience or projects
    const target = document.getElementById('experience');
    target?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
