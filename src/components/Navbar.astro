---
import MenuTrigger from '@/components/navbar/MenuTrigger.astro';
import ThemeToggle from '@/components/navbar/ThemeToggle.astro';
import MenuOverlay from '@/components/navbar/MenuOverlay.astro';
---

<header class="w-full pt-[max(1.25rem,env(safe-area-inset-top))] sm:pt-6 pb-6 sm:pb-12">
  <nav class="flex items-center justify-between" aria-label="Main Navigation">
    <!-- Left: Menu Button & Cmd + K Shortcut -->
    <MenuTrigger />

    <!-- Right: Theme Toggle Button -->
    <ThemeToggle />
  </nav>
</header>

<MenuOverlay />
