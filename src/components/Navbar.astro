---
// Navbar & iOS-style GSAP Menu Overlay matching Figma Desktop - 1 & #4:113
const navItems = [
  { index: '01', label: 'Home', href: '#' },
  { index: '02', label: 'About', href: '#hero-heading' },
  { index: '03', label: 'Experience', href: '#experience' },
  { index: '04', label: 'Projects', href: '#projects' },
  { index: '05', label: 'Social', href: '#social' },
];
---

<header class="w-full pt-[max(1.25rem,env(safe-area-inset-top))] sm:pt-6 pb-6 sm:pb-12">
  <nav class="flex items-center justify-between" aria-label="Main Navigation">
    <!-- Left: Menu Button & Cmd + K Shortcut -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="menu-toggle-btn"
        aria-expanded="false"
        aria-controls="menu-overlay"
        class="theme-btn-surface inline-flex items-center justify-center px-3.5 py-0.5 rounded border border-ink-subtle text-ink text-base focus:outline-none focus-visible:ring-1 focus-visible:ring-ink-subtle"
      >
        Menu
      </button>

      <!-- Keyboard Shortcut Indicator -->
      <div class="flex items-center gap-2 text-ink-muted" aria-label="Shortcut: Command K">
        <span
          class="inline-flex items-center justify-center w-[25px] h-[25px] rounded-[2px] border border-ink-subtle text-xs select-none"
          title="Command"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Mac Command Symbol ⌘ -->
            <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
          </svg>
        </span>
        <span
          class="inline-flex items-center justify-center w-[25px] h-[25px] rounded-[2px] border border-ink-subtle text-sm font-normal select-none"
        >
          K
        </span>
      </div>
    </div>

    <!-- Right: Theme Toggle Button -->
    <div>
      <button
        type="button"
        id="theme-btn"
        aria-label="Toggle color theme"
        aria-pressed="false"
        class="theme-btn-surface inline-flex items-center justify-center px-3.5 py-0.5 rounded border border-ink-subtle text-ink text-base focus:outline-none focus-visible:ring-1 focus-visible:ring-ink-subtle"
      >
        <span class="relative inline-grid overflow-hidden align-middle">
          <span
            data-theme-label="dark"
            class="col-start-1 row-start-1 text-center will-change-[transform,opacity]"
          >
            Dark
          </span>
          <span
            data-theme-label="light"
            class="col-start-1 row-start-1 text-center will-change-[transform,opacity]"
          >
            Light
          </span>
        </span>
      </button>
    </div>
  </nav>
</header>

<!-- Centered Menu Overlay matching Figma node #4:113 (426x373, 1px subtle border, 4px radius) -->
<div
  id="menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="menu-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none"
>
  <!-- Translucent Backdrop -->
  <div
    id="menu-backdrop"
    class="absolute inset-0 bg-[var(--color-backdrop)] backdrop-blur-[4px] opacity-0"
  ></div>

  <!-- Menu Modal Panel -->
  <div
    id="menu-panel"
    style="visibility: hidden;"
    class="relative z-10 w-[min(426px,calc(100vw-2.5rem))] min-h-[373px] bg-canvas border border-ink-subtle rounded-[4px] p-6 flex flex-col justify-between opacity-0 will-change-[transform,opacity]"
  >
    <!-- Overlay Top Bar -->
    <div class="flex items-center justify-between pb-4 border-b border-ink-subtle/30">
      <span id="menu-overlay-title" class="text-[16px] text-ink font-normal">
        Menu
      </span>
      <button
        type="button"
        id="menu-close-btn"
        class="theme-btn-surface inline-flex items-center justify-center gap-1.5 px-3 py-0.5 rounded-[4px] border border-ink-subtle text-ink-muted text-sm hover:text-ink focus:outline-none focus-visible:ring-1 focus-visible:ring-ink-subtle"
      >
        <span>Close</span>
        <span class="text-ink-subtle text-xs">Esc</span>
      </button>
    </div>

    <!-- Navigation List -->
    <nav class="flex flex-col gap-1 py-4" aria-label="Menu Navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-menu-item
            class="menu-nav-link flex items-center justify-between px-2 py-2 rounded-[4px] text-[18px] text-ink-muted font-normal focus:outline-none focus-visible:ring-1 focus-visible:ring-ink-subtle"
          >
            <span>{item.label}</span>
            <span class="font-mono text-xs text-ink-subtle">{item.index}</span>
          </a>
        ))
      }
    </nav>

    <!-- Overlay Footer Row -->
    <div
      data-menu-item
      class="flex items-center justify-between pt-4 border-t border-ink-subtle/30 text-xs text-ink-subtle"
    >
      <span>arsy</span>
      <span class="font-mono">↑↓ Navigate · ↵ Select · ESC</span>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';

  /**
   * Exact CSS cubic-bezier solver so GSAP follows the animate skill curves
   * (--ease-drawer and --ease-out) without approximations.
   */
  function cubicBezier(x1: number, y1: number, x2: number, y2: number) {
    const cx = 3 * x1;
    const bx = 3 * (x2 - x1) - cx;
    const ax = 1 - cx - bx;

    const cy = 3 * y1;
    const by = 3 * (y2 - y1) - cy;
    const ay = 1 - cy - by;

    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;
    const sampleDerivativeX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;

    const solveT = (x: number) => {
      let t = x;
      for (let i = 0; i < 6; i++) {
        const dx = sampleX(t) - x;
        if (Math.abs(dx) < 1e-6) return t;
        const d = sampleDerivativeX(t);
        if (Math.abs(d) < 1e-6) break;
        t -= dx / d;
      }
      let lo = 0;
      let hi = 1;
      t = x;
      while (lo < hi) {
        const currentX = sampleX(t);
        if (Math.abs(currentX - x) < 1e-6) return t;
        if (x > currentX) lo = t;
        else hi = t;
        t = (lo + hi) * 0.5;
        if (hi - lo < 1e-6) break;
      }
      return t;
    };

    return (u: number) => {
      if (u <= 0) return 0;
      if (u >= 1) return 1;
      return sampleY(solveT(u));
    };
  }

  const easeDrawer = cubicBezier(0.32, 0.72, 0, 1); // --ease-drawer
  const easeOut = cubicBezier(0.23, 1, 0.32, 1); // --ease-out

  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const canHoverFine = () =>
    window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  const menuBtn = document.getElementById('menu-toggle-btn') as HTMLButtonElement | null;
  const overlay = document.getElementById('menu-overlay') as HTMLDivElement | null;
  const backdrop = document.getElementById('menu-backdrop') as HTMLDivElement | null;
  const panel = document.getElementById('menu-panel') as HTMLDivElement | null;
  const closeBtn = document.getElementById('menu-close-btn') as HTMLButtonElement | null;

  if (menuBtn && overlay && backdrop && panel) {
    const menuItems = Array.from(panel.querySelectorAll<HTMLElement>('[data-menu-item]'));
    const navLinks = Array.from(panel.querySelectorAll<HTMLAnchorElement>('.menu-nav-link'));

    let isOpen = false;
    let activeIndex = 0;
    let lastFocusedEl: HTMLElement | null = null;

    const setActiveIndex = (index: number, focusLink = true) => {
      if (!navLinks.length) return;
      activeIndex = (index + navLinks.length) % navLinks.length;
      navLinks.forEach((link, idx) => {
        const active = idx === activeIndex;
        link.setAttribute('data-active', active ? 'true' : 'false');
        if (active) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
      if (focusLink) {
        navLinks[activeIndex]?.focus({ preventScroll: true });
      }
    };

    const getOriginOffsets = () => {
      const btnRect = menuBtn.getBoundingClientRect();
      const btnCenterX = btnRect.left + btnRect.width / 2;
      const btnCenterY = btnRect.top + btnRect.height / 2;

      // offsetLeft/Top/Width/Height ignore active CSS transforms, giving the exact
      // centered identity rect even if interrupted mid-flight.
      const panelWidth = panel.offsetWidth || 426;
      const panelHeight = panel.offsetHeight || 373;
      const panelCenterX = panel.offsetLeft + panelWidth / 2;
      const panelCenterY = panel.offsetTop + panelHeight / 2;

      return {
        dx: btnCenterX - panelCenterX,
        dy: btnCenterY - panelCenterY,
        sx: Math.max(0.18, menuBtn.offsetWidth / panelWidth),
        sy: Math.max(0.12, menuBtn.offsetHeight / panelHeight),
      };
    };

    const openMenu = () => {
      if (isOpen) return;
      isOpen = true;
      lastFocusedEl = document.activeElement as HTMLElement | null;

      menuBtn.setAttribute('aria-expanded', 'true');
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.remove('pointer-events-none');
      overlay.classList.add('pointer-events-auto');

      const wasAnimating = gsap.isTweening(panel);
      gsap.killTweensOf([panel, backdrop, menuBtn, ...menuItems]);

      if (prefersReducedMotion()) {
        gsap.set(panel, {
          visibility: 'visible',
          x: 0,
          y: 0,
          scaleX: 1,
          scaleY: 1,
        });
        gsap.to(panel, { opacity: 1, duration: 0.18, ease: easeOut });
        gsap.to(backdrop, { opacity: 1, duration: 0.18, ease: easeOut });
        gsap.set(menuItems, { opacity: 1, y: 0 });
        gsap.to(menuBtn, { opacity: 0, duration: 0.18, ease: easeOut });
        setActiveIndex(0, true);
        return;
      }

      const { dx, dy, sx, sy } = getOriginOffsets();

      if (!wasAnimating) {
        gsap.set(panel, {
          visibility: 'visible',
          x: dx,
          y: dy,
          scaleX: sx,
          scaleY: sy,
          opacity: 0,
        });
      } else {
        gsap.set(panel, { visibility: 'visible' });
      }

      gsap.to(panel, {
        x: 0,
        y: 0,
        scaleX: 1,
        scaleY: 1,
        opacity: 1,
        duration: 1.0,
        ease: easeDrawer,
        overwrite: 'auto',
      });

      gsap.to(backdrop, {
        opacity: 1,
        duration: 0.85,
        ease: easeOut,
        overwrite: 'auto',
      });

      gsap.to(menuBtn, {
        opacity: 0,
        scale: 0.95,
        duration: 0.3,
        ease: easeOut,
        overwrite: 'auto',
      });

      gsap.fromTo(
        menuItems,
        { opacity: 0, y: 8 },
        {
          opacity: 1,
          y: 0,
          duration: 0.45,
          stagger: 0.05,
          delay: wasAnimating ? 0.05 : 0.22,
          ease: easeOut,
          overwrite: 'auto',
        },
      );

      setActiveIndex(0, true);
    };

    const closeMenu = (restoreFocus = true) => {
      if (!isOpen) return;
      isOpen = false;

      menuBtn.setAttribute('aria-expanded', 'false');
      overlay.setAttribute('aria-hidden', 'true');
      overlay.classList.remove('pointer-events-auto');
      overlay.classList.add('pointer-events-none');

      gsap.killTweensOf([panel, backdrop, menuBtn, ...menuItems]);

      if (prefersReducedMotion()) {
        gsap.to(panel, {
          opacity: 0,
          duration: 0.18,
          ease: easeOut,
          onComplete: () => {
            if (!isOpen) gsap.set(panel, { visibility: 'hidden' });
          },
        });
        gsap.to(backdrop, { opacity: 0, duration: 0.18, ease: easeOut });
        gsap.to(menuBtn, { opacity: 1, duration: 0.18, ease: easeOut });
        if (restoreFocus && lastFocusedEl) {
          lastFocusedEl.focus({ preventScroll: true });
        }
        return;
      }

      const { dx, dy, sx, sy } = getOriginOffsets();

      gsap.to(menuItems, {
        opacity: 0,
        duration: 0.3,
        ease: easeOut,
        overwrite: 'auto',
      });

      gsap.to(panel, {
        x: dx,
        y: dy,
        scaleX: sx,
        scaleY: sy,
        opacity: 0,
        duration: 1.0,
        ease: easeDrawer,
        overwrite: 'auto',
        onComplete: () => {
          if (!isOpen) gsap.set(panel, { visibility: 'hidden' });
        },
      });

      gsap.to(backdrop, {
        opacity: 0,
        duration: 0.85,
        ease: easeOut,
        overwrite: 'auto',
      });

      gsap.to(menuBtn, {
        opacity: 1,
        scale: 1,
        duration: 0.4,
        delay: 0.55,
        ease: easeOut,
        overwrite: 'auto',
      });

      if (restoreFocus && lastFocusedEl) {
        lastFocusedEl.focus({ preventScroll: true });
      }
    };

    menuBtn.addEventListener('click', () => {
      if (isOpen) closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener('click', () => closeMenu());
    backdrop.addEventListener('click', () => closeMenu());

    navLinks.forEach((link, idx) => {
      link.addEventListener('pointerenter', () => {
        if (isOpen && canHoverFine()) {
          setActiveIndex(idx, false);
        }
      });

      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href) return;
        closeMenu(false);

        if (href === '#') {
          e.preventDefault();
          window.scrollTo({
            top: 0,
            behavior: prefersReducedMotion() ? 'auto' : 'smooth',
          });
          return;
        }

        if (href.startsWith('#')) {
          e.preventDefault();
          const target = document.querySelector(href);
          target?.scrollIntoView({
            behavior: prefersReducedMotion() ? 'auto' : 'smooth',
          });
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      if (isOpen) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMenu();
          return;
        }

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActiveIndex((activeIndex + 1) % navLinks.length);
          return;
        }

        if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActiveIndex((activeIndex - 1 + navLinks.length) % navLinks.length);
          return;
        }

        if (e.key === 'Enter') {
          const activeEl = document.activeElement;
          if (!(activeEl instanceof HTMLButtonElement) && !(activeEl instanceof HTMLAnchorElement)) {
            e.preventDefault();
            navLinks[activeIndex]?.click();
            return;
          }
        }
      }

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isOpen) closeMenu();
        else openMenu();
      }
    });
  }

  type Theme = 'dark' | 'light';

  const themeBtn = document.getElementById('theme-btn') as HTMLButtonElement | null;
  const pageShell = document.getElementById('page-shell') as HTMLDivElement | null;
  const transitionStage = document.getElementById('theme-transition-stage') as HTMLDivElement | null;

  if (themeBtn) {
    const darkLabel = themeBtn.querySelector<HTMLElement>('[data-theme-label="dark"]');
    const lightLabel = themeBtn.querySelector<HTMLElement>('[data-theme-label="light"]');

    let activeTheme: Theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    let stageTheme: Theme | null = null;
    let isStageVisible = false;
    let activeStageTween: gsap.core.Tween | null = null;
    const clipState = { r: 0 };
    let originX = 0;
    let originY = 0;
    let maxRadius = 0;
    let clonedShell: HTMLElement | null = null;
    let cloneDarkLabel: HTMLElement | null = null;
    let cloneLightLabel: HTMLElement | null = null;
    let scrollListenerAttached = false;

    const persistTheme = (theme: Theme) => {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // Ignore storage errors in restricted contexts.
      }
      const metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor) {
        metaThemeColor.setAttribute('content', theme === 'light' ? '#f8fafb' : '#060e13');
      }
    };

    const syncLabelPair = (
      darkEl: HTMLElement | null,
      lightEl: HTMLElement | null,
      theme: Theme,
      animate: boolean,
    ) => {
      if (!darkEl || !lightEl) return;

      const reduced = prefersReducedMotion();
      const darkProps = {
        y: 0,
        yPercent: reduced ? 0 : theme === 'dark' ? 0 : -100,
        opacity: theme === 'dark' ? 1 : 0,
      };
      const lightProps = {
        y: 0,
        yPercent: reduced ? 0 : theme === 'light' ? 0 : 100,
        opacity: theme === 'light' ? 1 : 0,
      };

      if (!animate) {
        gsap.set(darkEl, darkProps);
        gsap.set(lightEl, lightProps);
        return;
      }

      const duration = reduced ? 0.18 : 0.24;
      gsap.to(darkEl, { ...darkProps, duration, ease: easeOut, overwrite: 'auto' });
      gsap.to(lightEl, { ...lightProps, duration, ease: easeOut, overwrite: 'auto' });
    };

    const updateButtonState = (theme: Theme, animate: boolean) => {
      themeBtn.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
      syncLabelPair(darkLabel, lightLabel, theme, animate);
      if (cloneDarkLabel && cloneLightLabel) {
        syncLabelPair(cloneDarkLabel, cloneLightLabel, theme, animate);
      }
    };

    const syncCloneScroll = () => {
      if (!clonedShell) return;
      clonedShell.style.transform = `translate3d(0, -${window.scrollY}px, 0)`;
    };

    const attachScrollSync = () => {
      if (scrollListenerAttached) return;
      window.addEventListener('scroll', syncCloneScroll, { passive: true });
      scrollListenerAttached = true;
    };

    const detachScrollSync = () => {
      if (!scrollListenerAttached) return;
      window.removeEventListener('scroll', syncCloneScroll);
      scrollListenerAttached = false;
    };

    const getCircleMetrics = () => {
      const rect = themeBtn.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const r = Math.hypot(
        Math.max(cx, window.innerWidth - cx),
        Math.max(cy, window.innerHeight - cy),
      );
      return { cx, cy, r };
    };

    const finalizeStage = (commitTheme: Theme) => {
      activeStageTween = null;
      document.documentElement.dataset.theme = commitTheme;
      isStageVisible = false;
      stageTheme = null;
      detachScrollSync();

      if (transitionStage) {
        transitionStage.style.visibility = 'hidden';
        transitionStage.style.clipPath = '';
        transitionStage.style.opacity = '';
        transitionStage.removeAttribute('data-theme');
        transitionStage.replaceChildren();
      }

      clonedShell = null;
      cloneDarkLabel = null;
      cloneLightLabel = null;
    };

    // Sync initial button label state on mount.
    updateButtonState(activeTheme, false);

    themeBtn.addEventListener('click', () => {
      const prevTheme = activeTheme;
      activeTheme = prevTheme === 'dark' ? 'light' : 'dark';
      persistTheme(activeTheme);

      if (!transitionStage || !pageShell) {
        document.documentElement.dataset.theme = activeTheme;
        updateButtonState(activeTheme, true);
        return;
      }

      const reduced = prefersReducedMotion();
      const metrics = getCircleMetrics();
      originX = metrics.cx;
      originY = metrics.cy;
      maxRadius = metrics.r;

      if (!isStageVisible) {
        const clone = pageShell.cloneNode(true) as HTMLElement;
        clone.removeAttribute('id');
        clone.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
        clone.setAttribute('inert', '');
        clone.style.willChange = 'transform';

        clonedShell = clone;
        cloneDarkLabel = clone.querySelector<HTMLElement>('[data-theme-label="dark"]');
        cloneLightLabel = clone.querySelector<HTMLElement>('[data-theme-label="light"]');
        cloneDarkLabel?.removeAttribute('style');
        cloneLightLabel?.removeAttribute('style');

        stageTheme = activeTheme;
        isStageVisible = true;
        transitionStage.dataset.theme = activeTheme;
        transitionStage.replaceChildren(clone);
        syncCloneScroll();
        attachScrollSync();

        if (reduced) {
          syncLabelPair(cloneDarkLabel, cloneLightLabel, activeTheme, false);
          themeBtn.setAttribute('aria-pressed', activeTheme === 'light' ? 'true' : 'false');
          syncLabelPair(darkLabel, lightLabel, activeTheme, true);

          transitionStage.style.clipPath = '';
          transitionStage.style.opacity = '0';
          transitionStage.style.visibility = 'visible';

          activeStageTween = gsap.to(transitionStage, {
            opacity: 1,
            duration: 0.18,
            ease: easeOut,
            overwrite: 'auto',
            onComplete: () => finalizeStage(activeTheme),
          });
          return;
        }

        // Start clone labels at prevTheme so they animate in lockstep inside the expanding circle.
        syncLabelPair(cloneDarkLabel, cloneLightLabel, prevTheme, false);
        updateButtonState(activeTheme, true);

        clipState.r = 0;
        transitionStage.style.opacity = '1';
        transitionStage.style.clipPath = `circle(0px at ${originX}px ${originY}px)`;
        transitionStage.style.visibility = 'visible';

        activeStageTween = gsap.to(clipState, {
          r: maxRadius,
          duration: 0.5,
          ease: easeOut,
          onUpdate: () => {
            transitionStage.style.clipPath = `circle(${clipState.r}px at ${originX}px ${originY}px)`;
          },
          onComplete: () => finalizeStage(activeTheme),
        });
        return;
      }

      // Interrupted mid-flight while stage is visible and html.dataset.theme hasn't flipped yet.
      activeStageTween?.kill();
      updateButtonState(activeTheme, true);

      if (reduced) {
        const targetOpacity = activeTheme === stageTheme ? 1 : 0;
        activeStageTween = gsap.to(transitionStage, {
          opacity: targetOpacity,
          duration: 0.18,
          ease: easeOut,
          overwrite: 'auto',
          onComplete: () => finalizeStage(activeTheme),
        });
        return;
      }

      const expandingToStage = activeTheme === stageTheme;
      const targetRadius = expandingToStage ? maxRadius : 0;
      const duration = expandingToStage ? 0.5 : 0.35;

      activeStageTween = gsap.to(clipState, {
        r: targetRadius,
        duration,
        ease: easeOut,
        onUpdate: () => {
          transitionStage.style.clipPath = `circle(${clipState.r}px at ${originX}px ${originY}px)`;
        },
        onComplete: () => finalizeStage(activeTheme),
      });
    });
  }
</script>
