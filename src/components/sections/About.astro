---
import SectionHeader from '../SectionHeader.astro';

const facts = [
  { label: 'Location', value: 'Samarinda, Indonesia' },
  { label: 'Experience', value: '1+ Years' },
  { label: 'Role', value: 'Frontend Dev & UI/UX Designer' },
  { label: 'Availability', value: 'Open for Projects' },
];
---

<section id="about" class="scroll-mt-20 bg-canvas py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="gap-14 lg:grid-cols-12 lg:gap-10">

      <div class="space-y-12 lg:col-span-6 lg:col-start-7">
        <p class="max-w-2xl text-lg leading-relaxed text-ink/75 md:text-xl">
          I'm a web developer passionate about creating beautiful, functional, and user-centered digital experiences.
        </p>
      </div>
    </div>
  </div>
</section>
