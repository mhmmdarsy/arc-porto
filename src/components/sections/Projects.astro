---
// Projects Section matching Figma Desktop - 1
const projects = [
  {
    name: 'RANA',
    year: '2026',
    link: '#',
  },
];
---

<section id="projects" class="flex flex-col gap-6 py-6" aria-labelledby="projects-heading">
  <!-- Section Title (Geist 24px, #FFFFFF) -->
  <h2 id="projects-heading" class="text-[24px] font-normal text-[#FFFFFF]">
    Projects
  </h2>

  <!-- Projects List -->
  <div class="flex flex-col gap-4 sm:gap-6">
    {
      projects.map((project) => (
        <a
          href={project.link}
          class="group flex items-center justify-between text-[16px] text-[#C1C1C1] font-normal hover:text-[#FFFFFF] transition-colors"
        >
          <span class="group-hover:underline underline-offset-4">{project.name}</span>
          <span>{project.year}</span>
        </a>
      ))
    }
  </div>
</section>
