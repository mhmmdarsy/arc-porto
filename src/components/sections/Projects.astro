---
// Projects Section matching Figma Desktop - 1
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ProjectItem from '@/components/sections/projects/ProjectItem.astro';
import { projects } from '@/data/projects';
---

<section id="projects" class="flex flex-col gap-5 sm:gap-6 py-4 sm:py-6" aria-labelledby="projects-heading">
  <!-- Section Title (Geist 24px) -->
  <SectionHeading id="projects-heading">Projects</SectionHeading>

  <!-- Projects List -->
  <div class="flex flex-col gap-4 sm:gap-6">
    {projects.map((project) => <ProjectItem project={project} />)}
  </div>
</section>
