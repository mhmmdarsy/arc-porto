---
import SectionHeader from '../SectionHeader.astro';

const projects = [
  {
    number: '01',
    title: 'WORKS',
    description: 'PORTFOLIO SHOWCASE',
    accent: '#7c3aed',
    offset: 'lg:ml-0',
  },
  {
    number: '02',
    title: 'DESIGN',
    description: 'CREATIVE SOLUTIONS',
    accent: '#2563eb',
    offset: 'lg:ml-auto',
  },
  {
    number: '03',
    title: 'CODE',
    description: 'TECHNICAL EXCELLENCE',
    accent: '#f59e0b',
    offset: 'lg:ml-0',
  },
];
---

<section id="projects" class="scroll-mt-20 bg-canvas py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <SectionHeader number="04" label="Projects" />

    <div class="mt-24 space-y-24 md:mt-32 md:space-y-32">
      {
        projects.map((project) => (
          <div class={`max-w-5xl ${project.offset}`}>
            <div class="mb-7 flex items-start gap-2">
              <div
                class="border-4 border-ink px-5 py-2.5 font-black text-ink"
                style={`background:${project.accent}`}
              >
                {project.number}
              </div>
              <div class="px-4 py-2.5">
                <span class="font-bold uppercase tracking-wider">
                  {project.description}
                </span>
              </div>
            </div>

            <a href="#contact" class="group relative block cursor-pointer">
              <div
                class="absolute inset-0 translate-x-4 translate-y-4 border-4 border-ink transition-transform duration-300 group-hover:translate-x-5 group-hover:translate-y-5"
                style={`background:${project.accent}`}
              />
              <div class="relative h-[280px] overflow-hidden border-4 border-ink bg-white transition-transform duration-300 group-hover:-translate-x-1.5 group-hover:-translate-y-1.5 md:h-[400px]">
                <div class="absolute inset-0 flex items-center justify-center">
                  <h2
                    class="pointer-events-none select-none text-[clamp(4.5rem,18vw,14rem)] font-black uppercase leading-none tracking-tighter text-ink"
                    style="letter-spacing:-0.05em"
                  >
                    {project.title}
                  </h2>
                </div>

                <div class="absolute left-6 top-6 z-10 md:left-8 md:top-8">
                  <div class="border-4 border-ink bg-white px-4 py-2">
                    <span class="font-black">VIEW PROJECT</span>
                  </div>
                </div>

                <div class="absolute bottom-6 right-6 z-10 md:bottom-8 md:right-8">
                  <div
                    class="flex h-14 w-14 items-center justify-center border-4 border-ink bg-white transition-colors duration-300 group-hover:bg-ink"
                  >
                    <svg
                      class="h-7 w-7 text-ink transition-colors duration-300 group-hover:text-white"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="square"
                        stroke-width="4"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </div>
                </div>

                <div class="absolute bottom-6 left-6 z-10 flex gap-2 md:bottom-8 md:left-8">
                  <div class="h-3 w-16 border-2 border-ink bg-ink"></div>
                  <div
                    class="h-3 w-28 border-2 border-ink"
                    style={`background:${project.accent}`}
                  ></div>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
