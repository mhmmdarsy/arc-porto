---
// Projects Section matching Figma Desktop - 1
const projects = [
  {
    name: 'RANA',
    year: '2026',
    link: '#',
  },
];
---

<section id="projects" class="flex flex-col gap-5 sm:gap-6 py-4 sm:py-6" aria-labelledby="projects-heading">
  <!-- Section Title (Geist 24px) -->
  <h2 id="projects-heading" class="text-[20px] sm:text-[24px] font-normal text-ink">
    Projects
  </h2>

  <!-- Projects List -->
  <div class="flex flex-col gap-4 sm:gap-6">
    {
      projects.map((project) => (
        <a
          href={project.link}
          class="group flex items-center justify-between gap-4 text-[15px] sm:text-[16px] text-ink-muted font-normal hover:text-ink transition-colors"
        >
          <span class="group-hover:underline underline-offset-4">{project.name}</span>
          <span>{project.year}</span>
        </a>
      ))
    }
  </div>
</section>
