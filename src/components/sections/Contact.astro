---
import SectionHeader from '../SectionHeader.astro';
---

<section id="contact" class="scroll-mt-20 bg-canvas py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <SectionHeader number="05" label="Contact" />

    <div class="mb-16 md:mb-20">
      <h2
        class="mb-10 text-5xl font-black uppercase leading-[0.88] tracking-tighter md:mb-12 md:text-7xl lg:text-8xl"
      >
        Let's<br />Work<br />Together
      </h2>
      <p class="max-w-2xl text-lg leading-relaxed text-ink/70 md:text-xl">
        Have a project in mind or want to collaborate? I'm always open to
        discussing new opportunities. Let's get in touch!
      </p>
    </div>

    <div class="mb-16 grid grid-cols-1 gap-10 md:mb-20 md:grid-cols-2 md:gap-12">
      <div class="border-t-2 border-line pt-8">
        <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40">
          Email
        </p>
        <a
          href="mailto:muhammadarsyalfahd@gmail.com"
          class="inline-block break-all text-2xl uppercase tracking-tight transition-opacity hover:opacity-60 md:text-3xl"
        >
          muhammadarsyalfahd@gmail.com
        </a>
      </div>

      <div class="border-t-2 border-line pt-8">
        <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.22em] text-ink/40">
          Social
        </p>
        <div class="space-y-3">
          <a
            href="https://github.com/mhmmdarsy"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-xl uppercase tracking-tight transition-opacity hover:opacity-60"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/mhmdarsy/"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-xl uppercase tracking-tight transition-opacity hover:opacity-60"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 text-center">
      <a href="mailto:muhammadarsyalfahd@gmail.com" class="pill-solid px-10 py-4 text-base">
        Reach Me Out
      </a>
    </div>

    <div class="mt-16 text-center">
      <p class="mb-2 text-sm text-ink/45">Available for freelance projects</p>
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink/30">
        Response time: 1-2 hours
      </p>
    </div>
  </div>
</section>
