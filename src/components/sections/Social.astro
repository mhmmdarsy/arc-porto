---
// Social Section matching Figma Desktop - 1
import SectionHeading from '@/components/ui/SectionHeading.astro';
import EmailCopyRow from '@/components/sections/social/EmailCopyRow.astro';
import SocialLinkItem from '@/components/sections/social/SocialLinkItem.astro';
import { contactEmail, socials } from '@/data/social';
---

<section id="social" class="flex flex-col gap-5 sm:gap-6 py-4 sm:py-6" aria-labelledby="social-heading">
  <!-- Section Title (Geist 24px) -->
  <SectionHeading id="social-heading">Social</SectionHeading>

  <div class="flex flex-col gap-5 sm:gap-6 text-[15px] sm:text-[16px]">
    <!-- Email with Copy Button -->
    <EmailCopyRow email={contactEmail} />

    <!-- Other Social Accounts -->
    {socials.map((social) => <SocialLinkItem social={social} />)}
  </div>
</section>
