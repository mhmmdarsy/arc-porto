---
import type { SocialItem } from '@/data/social';

interface Props {
  social: SocialItem;
}

const { social } = Astro.props;
---

<div class="flex flex-col gap-1.5">
  <span class="text-ink-muted">{social.platform}</span>
  <div>
    <a
      href={social.url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-ink underline underline-offset-4 hover:bg-selection-bg hover:text-selection-fg transition-colors inline-block"
    >
      {social.handle}
    </a>
  </div>
</div>
