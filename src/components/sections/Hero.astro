---
import { heroContent } from '@/data/site';
---

<section class="flex flex-col gap-6 sm:gap-[46px] pt-12 sm:pt-[280px] pb-2 sm:pb-4" aria-labelledby="hero-heading">
  <!-- Heading (Geist 40px) -->
  <h1
    id="hero-heading"
    class="text-[28px] sm:text-[40px] leading-[1.25] sm:leading-[1.2] font-normal text-ink tracking-normal"
  >
    {heroContent.headingLead}<br class="hidden sm:inline" /> {heroContent.headingTrailing}
  </h1>

  <!-- Bio Descriptions (Geist 16px) -->
  <div class="flex flex-col gap-5 sm:gap-6 text-[15px] sm:text-[16px] leading-[1.65] sm:leading-[1.6] text-ink-muted font-normal">
    <p>
      I am currently pursuing a Bachelor’s degree in{' '}
      <span class="underline underline-offset-4">{heroContent.degree}</span>{' '}
      at{' '}
      <span class="underline underline-offset-4">{heroContent.university}</span>. 
      {heroContent.interestText}
    </p>

    <p>
      I graduated from the {heroContent.programHours}{' '}
      <span class="underline underline-offset-4">{heroContent.programName}</span>{' '}
      led by{' '}
      <a
        href={heroContent.partners.dicoding.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent-blue underline underline-offset-4 hover:opacity-80 transition-opacity"
      >
        {heroContent.partners.dicoding.label}
      </a>{' '}
      &amp;{' '}
      <a
        href={heroContent.partners.accenture.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent-purple underline underline-offset-4 hover:opacity-80 transition-opacity"
      >
        {heroContent.partners.accenture.label}
      </a>{' '}
      {heroContent.programSummary}
    </p>

    <p>
      {heroContent.aboutLink.prefix}{' '}
      <a
        href={heroContent.aboutLink.href}
        class="underline underline-offset-4 hover:text-ink transition-colors"
      >
        {heroContent.aboutLink.label}
      </a>.
    </p>
  </div>
</section>
