---
// Experience Section matching Figma Desktop - 1
const experiences = [
  {
    role: 'Software Engineer Freelance',
    period: 'Apr 2026 - Now',
  },
  {
    role: 'UI/UX Designer Intern',
    period: 'Jan - May 2026',
  },
  {
    role: 'Laboratory Assistant',
    period: 'Sep - Nov 2025 & Feb - Apr 2026',
  },
  {
    role: 'Web Development Bootcamp (ASAH Program)',
    period: 'Aug 2025 - Jan 2026',
  },
];
---

<section id="experience" class="flex flex-col gap-5 sm:gap-[26px] pb-4 sm:pb-5" aria-labelledby="experience-heading">
  <!-- Section Title (Geist 24px) -->
  <h2 id="experience-heading" class="text-[20px] sm:text-[24px] font-normal text-ink">
    Experience
  </h2>

  <!-- Experience List -->
  <div class="flex flex-col gap-5 sm:gap-1.5">
    {
      experiences.map((item, index) => (
        <>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 text-[15px] sm:text-[16px] text-ink-muted font-normal">
            <span>{item.role}</span>
            <span class="text-ink-muted/80 sm:text-ink-muted">{item.period}</span>
          </div>
          {index < experiences.length - 1 && (
            <div
              class="hidden sm:block w-px h-[29px] bg-ink-muted mr-[20px] self-end"
              aria-hidden="true"
            />
          )}
        </>
      ))
    }
  </div>
</section>
