---
// Experience Section matching Figma Desktop - 1
const experiences = [
  {
    role: 'Software Engineer Freelance',
    period: 'Apr 2026 - Now',
  },
  {
    role: 'UI/UX Designer Intern',
    period: 'Jan - May 2026',
  },
  {
    role: 'Laboratory Assistant',
    period: 'Sep - Nov 2025 & Feb - Apr 2026',
  },
  {
    role: 'Web Development Bootcamp (ASAH Program)',
    period: 'Aug 2025 - Jan 2026',
  },
];
---

<section id="experience" class="flex flex-col gap-[26px] pb-5" aria-labelledby="experience-heading">
  <!-- Section Title (Geist 24px, #FFFFFF) -->
  <h2 id="experience-heading" class="text-[24px] font-normal text-[#FFFFFF]">
    Experience
  </h2>

  <!-- Experience List -->
  <div class="flex flex-col gap-1.5">
    {
      experiences.map((item, index) => (
        <>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[16px] text-[#C1C1C1] font-normal">
            <span>{item.role}</span>
            <span class="text-[#C1C1C1]/80 sm:text-[#C1C1C1]">{item.period}</span>
          </div>
          {index < experiences.length - 1 && (
            <div
              class="w-px h-[29px] bg-[#C1C1C1] mr-[20px] self-end"
              aria-hidden="true"
            />
          )}
        </>
      ))
    }
  </div>
</section>
