---
// Experience Section matching Figma Desktop - 1
const experiences = [
  {
    role: 'Software Engineer Freelance',
    period: 'Apr 2026 - Now',
  },
  {
    role: 'UI/UX Designer Intern',
    period: 'Jan - May 2026',
  },
  {
    role: 'Laboratory Assistant',
    period: 'Sep - Nov 2025 & Feb - Apr 2026',
  },
  {
    role: 'Web Development Bootcamp (ASAH Program)',
    period: 'Aug 2025 - Jan 2026',
  },
];
---

<section id="experience" class="flex flex-col gap-5 sm:gap-[26px] pb-4 sm:pb-5" aria-labelledby="experience-heading">
  <!-- Section Title (Geist 24px, #FFFFFF) -->
  <h2 id="experience-heading" class="text-[20px] sm:text-[24px] font-normal text-[#FFFFFF]">
    Experience
  </h2>

  <!-- Experience List -->
  <div class="flex flex-col gap-1.5">
    {
      experiences.map((item, index) => (
        <>
          <div class="flex items-start justify-between gap-4 text-[15px] sm:text-[16px] text-[#C1C1C1] font-normal">
            <span class="min-w-0 flex-1">{item.role}</span>
            <span class="text-right shrink-0 max-w-[48%] sm:max-w-none">{item.period}</span>
          </div>
          {index < experiences.length - 1 && (
            <div
              class="w-px h-[24px] sm:h-[29px] bg-[#C1C1C1] mr-[14px] sm:mr-[20px] self-end"
              aria-hidden="true"
            />
          )}
        </>
      ))
    }
  </div>
</section>
