---
// Experience Section matching Figma Desktop - 1
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ExperienceItem from '@/components/sections/experience/ExperienceItem.astro';
import { experiences } from '@/data/experience';
---

<section id="experience" class="flex flex-col gap-5 sm:gap-[26px] pb-4 sm:pb-5" aria-labelledby="experience-heading">
  <!-- Section Title (Geist 24px) -->
  <SectionHeading id="experience-heading">Experience</SectionHeading>

  <!-- Experience List -->
  <div class="flex flex-col gap-5 sm:gap-1.5">
    {
      experiences.map((item, index) => (
        <ExperienceItem item={item} showConnector={index < experiences.length - 1} />
      ))
    }
  </div>
</section>
