---
import { navItems } from '@/data/navigation';
---

<nav id="menu-nav" class="relative flex flex-col gap-1 py-4" aria-label="Menu Navigation">
  <div
    id="menu-active-indicator"
    aria-hidden="true"
    class="menu-active-indicator pointer-events-none absolute top-0 left-0 w-full rounded-[4px] opacity-0"
  ></div>
  {
    navItems.map((item) => (
      <a
        href={item.href}
        data-menu-item
        class="menu-nav-link relative z-10 flex items-center justify-between px-2 py-2 rounded-[4px] text-[18px] text-ink-muted font-normal focus:outline-none"
      >
        <span>{item.label}</span>
        <span class="font-mono text-xs text-ink-subtle">{item.index}</span>
      </a>
    ))
  }
</nav>
