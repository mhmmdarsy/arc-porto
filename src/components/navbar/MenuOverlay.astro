---
import MenuHeader from '@/components/navbar/menu/MenuHeader.astro';
import MenuNavList from '@/components/navbar/menu/MenuNavList.astro';
import MenuFooter from '@/components/navbar/menu/MenuFooter.astro';
---

<!-- Centered Menu Overlay matching Figma node #4:113 (426x373, 1px subtle border, 4px radius) -->
<div
  id="menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="menu-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none"
>
  <!-- Translucent Backdrop -->
  <div
    id="menu-backdrop"
    class="absolute inset-0 bg-[var(--color-backdrop)] backdrop-blur-[4px] opacity-0"
  ></div>

  <!-- Menu Modal Panel -->
  <div
    id="menu-panel"
    style="visibility: hidden;"
    class="relative z-10 w-[min(426px,calc(100vw-2.5rem))] min-h-[373px] bg-canvas border border-ink-subtle rounded-[4px] p-6 flex flex-col justify-between opacity-0 will-change-[transform,opacity]"
  >
    <!-- Overlay Top Bar -->
    <MenuHeader />

    <!-- Navigation List -->
    <MenuNavList />

    <!-- Overlay Footer Row -->
    <MenuFooter />
  </div>
</div>

<script>
  import { initMenuOverlay } from '@/scripts/menu-overlay';

  initMenuOverlay();
</script>
