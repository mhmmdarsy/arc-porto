---
import { siteMeta } from '@/data/site';
import { formatWitaTime } from '@/utils/time';

const initialWitaTime = formatWitaTime();
---

<div class="flex items-center gap-4 sm:gap-6 whitespace-nowrap">
  <span class="whitespace-nowrap">{siteMeta.location}</span>
  <div class="flex items-center gap-1.5 sm:gap-2 whitespace-nowrap">
    <time
      id="wita-clock"
      datetime=""
      class="font-sans tabular-nums select-none whitespace-nowrap"
      title={siteMeta.timezoneTitle}
    >
      {initialWitaTime}
    </time>
    <span class="whitespace-nowrap">{siteMeta.utcLabel}</span>
  </div>
</div>

<script>
  import { initWitaClock } from '@/scripts/wita-clock';

  initWitaClock();
</script>
