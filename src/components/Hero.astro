---
import Navbar from './Navbar.astro';
---

<Navbar />

<section
  id="top"
  class="dot-grid relative h-screen min-h-[680px] overflow-hidden"
>
  <!-- interactive pixel wave -->
  <div class="pointer-events-none absolute inset-0 z-0 opacity-45 md:opacity-100">
    <canvas id="wave" class="h-full w-full"></canvas>
  </div>

  <!-- mono eyebrows -->
  <div
    class="absolute left-6 top-28 z-10 font-mono text-[10px] leading-relaxed tracking-[0.22em] text-ink/45 md:left-10 md:text-[11px]"
  >
    based in samarinda, east kalimantan
  </div>

  <!-- main content -->
  <div
    class="relative z-10 mx-auto flex h-full max-w-[1600px] flex-col justify-end px-6 pb-10 md:px-10 md:pb-14"
  >
    <div class="grid grid-cols-1 items-end gap-12 lg:grid-cols-12 lg:gap-8">
      <h1
        class="font-black uppercase leading-[0.84] tracking-[-0.045em] text-ink lg:col-span-9"
        style="font-size: clamp(2.75rem, 9vw, 8.75rem)"
      >
        <span class="block">Craft,</span>
        <span class="block">Engineered.</span>
      </h1>

      <div class="max-w-[300px] lg:col-span-3 lg:col-start-10">
        <p class="text-[15px] leading-relaxed text-ink/75">
          An independent portfolio and creative studio designing digital
          products, websites, and brand experiences with artful precision and
          code.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#contact" class="pill-solid">
            Collaborate <span aria-hidden="true">↗</span>
          </a>
          <a href="#projects" class="pill-ghost"> View our work </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initPixelWave } from '../scripts/pixel-wave';

  const canvas = document.getElementById('wave');
  if (canvas instanceof HTMLCanvasElement) {
    initPixelWave(canvas);
  }
</script>
