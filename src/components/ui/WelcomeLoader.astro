---
---

<div
  id="welcome-loader"
  class="welcome-loader fixed inset-0 z-[70] hidden items-center justify-center px-5 sm:px-8 select-none pointer-events-auto"
  role="status"
  aria-label="Loading portfolio"
  aria-live="off"
>
  <span
    id="welcome-loader-percent"
    class="welcome-loader-digits font-sans text-[clamp(3.25rem,11vw,6.75rem)] font-normal leading-none tracking-normal text-[var(--loader-ink)] inline-flex items-baseline justify-end"
    aria-hidden="true"
  >
    <span data-digit="hundreds" class="welcome-loader-digit"></span>
    <span data-digit="tens" class="welcome-loader-digit"></span>
    <span data-digit="ones" class="welcome-loader-digit">1</span>
    <span class="welcome-loader-unit">%</span>
  </span>
</div>

<script>
  import { initWelcomeLoader } from '@/scripts/welcome-loader';

  initWelcomeLoader();
</script>
