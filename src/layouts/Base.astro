---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'craft. — Independent creative studio',
  description =
    'An independent portfolio and creative studio designing digital products, websites, and brand experiences with artful precision and code.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-ink">
    <slot />
    <script>
      import Lenis from 'lenis';

      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (!reduced) {
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 2,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        document.addEventListener('astro:before-swap', () => lenis.destroy());
      }

      document.documentElement.classList.add('is-ready');
    </script>
  </body>
</html>
